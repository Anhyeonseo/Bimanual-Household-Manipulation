<?xml version="1.0"?>
<robot name="so101_dual_preview">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="workcell_base_link"/>

  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_gripper_frame_link"/>
  </group>
  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_gripper_frame_link"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <group_state name="home" group="left_arm">
    <joint name="left_base_joint" value="0"/>
    <joint name="left_shoulder_joint" value="0"/>
    <joint name="left_elbow_joint" value="0"/>
    <joint name="left_wrist_flex_joint" value="0"/>
    <joint name="left_wrist_roll_joint" value="0"/>
  </group_state>
  <group_state name="home" group="right_arm">
    <joint name="right_base_joint" value="0"/>
    <joint name="right_shoulder_joint" value="0"/>
    <joint name="right_elbow_joint" value="0"/>
    <joint name="right_wrist_flex_joint" value="0"/>
    <joint name="right_wrist_roll_joint" value="0"/>
  </group_state>

  <disable_collisions link1="left_base_link" link2="left_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="left_base_link" link2="left_upper_arm_link" reason="Never"/>
  <disable_collisions link1="left_gripper_link" link2="left_lower_arm_link" reason="Never"/>
  <disable_collisions link1="left_gripper_link" link2="left_moving_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="left_gripper_link" link2="left_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="left_lower_arm_link" link2="left_moving_jaw_link" reason="Never"/>
  <disable_collisions link1="left_lower_arm_link" link2="left_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="left_lower_arm_link" link2="left_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="left_moving_jaw_link" link2="left_wrist_link" reason="Never"/>
  <disable_collisions link1="left_shoulder_link" link2="left_upper_arm_link" reason="Adjacent"/>

  <disable_collisions link1="right_base_link" link2="right_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="right_base_link" link2="right_upper_arm_link" reason="Never"/>
  <disable_collisions link1="right_gripper_link" link2="right_lower_arm_link" reason="Never"/>
  <disable_collisions link1="right_gripper_link" link2="right_moving_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="right_gripper_link" link2="right_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="right_lower_arm_link" link2="right_moving_jaw_link" reason="Never"/>
  <disable_collisions link1="right_lower_arm_link" link2="right_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="right_lower_arm_link" link2="right_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="right_moving_jaw_link" link2="right_wrist_link" reason="Never"/>
  <disable_collisions link1="right_shoulder_link" link2="right_upper_arm_link" reason="Adjacent"/>

  <disable_collisions link1="left_mount_arm_base_link" link2="left_base_link" reason="Assembly"/>
  <disable_collisions link1="right_mount_arm_base_link" link2="right_base_link" reason="Assembly"/>
  <disable_collisions link1="left_mount_arm_base_link" link2="top_cam_mount_bottom_link" reason="Assembly"/>
  <disable_collisions link1="right_mount_arm_base_link" link2="top_cam_mount_bottom_link" reason="Assembly"/>
  <disable_collisions link1="top_cam_mount_bottom_link" link2="top_cam_mount_top_link" reason="Adjacent"/>
</robot>
