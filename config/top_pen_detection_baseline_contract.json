{
  "protocol_version": 1,
  "scope": {
    "camera_mount_fixed": true,
    "camera_height_fixed": true,
    "object_z_fixed": true,
    "allowed_environment_changes": [
      "background",
      "lighting",
      "glare"
    ],
    "motion_authorized": false
  },
  "detector": {
    "backend": "legacy_dark_threshold",
    "threshold": 110,
    "min_area_px": 1000.0,
    "min_width_px": 20,
    "min_height_px": 20,
    "min_solidity": 0.5,
    "image_edge_margin_px": 8,
    "exclusion_rectangles_px": [
      [0, 410, 120, 70]
    ],
    "require_full_footprint": false
  },
  "coverage": {
    "minimum_positive_cases": 12,
    "minimum_negative_cases": 6,
    "minimum_background_labels": 2,
    "minimum_lighting_labels": 3,
    "minimum_glare_labels": 2
  },
  "acceptance": {
    "maximum_miss_rate": 0.05,
    "maximum_false_positive_rate": 0.02,
    "maximum_center_error_px_p95": 8.0,
    "maximum_yaw_error_deg_p95": 5.0
  }
}
