{
  "schema_version": 1,
  "contract_kind": "so101_policy_deployment",
  "bundle_kind": "so101_policy_onnx",
  "motion_authorized": false,
  "paths": {
    "must_be_relative": true,
    "must_stay_inside_bundle": true
  },
  "onnx": {
    "format": "onnx",
    "require_exact_io_names_dtypes_shapes": true,
    "require_static_batch_one": true,
    "require_static_nonbatch_dimensions": true,
    "allowed_dtypes": [
      "bool",
      "float16",
      "float32",
      "float64",
      "int32",
      "int64",
      "uint8"
    ]
  },
  "observation": {
    "allowed_modes": [
      "structured_state",
      "rgb_tensor",
      "hybrid"
    ],
    "allowed_camera_order": [
      "top",
      "wrist_a",
      "wrist_b"
    ],
    "stale_action": "reject",
    "skew_action": "reject"
  },
  "runtime": {
    "required_mode": "SHADOW",
    "required_backend": "onnxruntime_cpu",
    "command_publications_allowed": false,
    "minimum_rate_fraction": 0.9,
    "maximum_inference_p95_ms": 80.0
  },
  "safety": {
    "deadline_miss": "reject",
    "stale_observation": "reject",
    "source_skew": "reject",
    "nonfinite_output": "reject",
    "out_of_bounds_output": "reject",
    "manifest_mismatch": "refuse_start"
  },
  "action": {
    "allowed_representations": [
      "joint_position_residual_rad",
      "cartesian_residual_m_rad",
      "arm_selection"
    ],
    "require_order_scale_lower_upper_same_length": true
  },
  "provenance": {
    "required_sha256": [
      "checkpoint_sha256",
      "training_config_sha256",
      "export_config_sha256"
    ]
  }
}
